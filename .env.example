# NeuroPath AI — Environment Variables

# --- Required (Supabase) ---
# These are pre-populated in the Bolt environment. For local development,
# copy this file to .env and fill in your own Supabase project credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Optional (AI Enhancement) ---
# If set, the AI adapter will use OpenAI-compatible LLM calls.
# If NOT set, the app uses deterministic fallback logic for all features.
# The app is fully functional without these.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
